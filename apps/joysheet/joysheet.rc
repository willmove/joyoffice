#include <winver.h>
100 ICON "../../assets/joysheet/joysheet.ico"
1 VERSIONINFO
FILEVERSION JOYSHEET_VERSION_NUM
PRODUCTVERSION JOYSHEET_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "Joysheet contributors\0"
   VALUE "FileDescription", "Joysheet spreadsheet desktop\0"
   VALUE "FileVersion", JOYSHEET_VERSION_STR
   VALUE "ProductName", "Joysheet\0"
   VALUE "ProductVersion", JOYSHEET_VERSION_STR
   VALUE "OriginalFilename", "joysheet.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

