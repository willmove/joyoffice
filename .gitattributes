# Corpus inputs are hashed byte-for-byte (tests/fixtures/manifest.json).
# Never let checkout convert their LF line endings, including on Windows.
tests/fixtures/text/** -text
# Mail merge CSV deliberately mixes CRLF records with quoted LF values.
tests/fixtures/mail-merge/*.csv -text
*.docx binary
*.dotx binary
*.docm binary
*.dotm binary
*.doc binary
*.wps binary
*.pdf binary
*.ttf binary
*.pptx binary
*.potx binary
*.ppsx binary
*.joydeck binary
*.mp4 binary
*.wav binary
*.m4a binary
*.mp3 binary
# Migrated evidence and verbatim notices carry recorded byte hashes.
docs/joydeck/evidence/** -text
docs/joyoffice/validation/** -text
# Preserve the exact bytes recorded by JoyWord validation manifests.
docs/joyword/validation/20261102-completion/** -text whitespace=-blank-at-eof,cr-at-eol
docs/joyword/validation/20261102-exchange-ui/** -text whitespace=-blank-at-eof,cr-at-eol
docs/joyword/validation/20261102-file-workspace/** -text whitespace=-blank-at-eof,cr-at-eol
docs/joyword/validation/20261102-export-availability/** -text whitespace=-blank-at-eof,cr-at-eol
licenses/joydeck/** -text
# Preserve the pinned third-party license verbatim, including original spacing.
tests/fixtures/fonts/OFL.txt -whitespace

# Product code uses one stable source representation across host platforms.
apps/joysheet*/** text=auto eol=lf
crates/joysheet-*/** text=auto eol=lf
tools/joysheet/** text=auto eol=lf
scripts/joysheet/** text=auto eol=lf
assets/joysheet/** -text

# Historical evidence and provenance retain their original bytes and hashes.
docs/joysheet/evidence/** -text whitespace=cr-at-eol
docs/joysheet/legacy-source/** -text whitespace=cr-at-eol
docs/joysheet/upstream-source.json -text whitespace=cr-at-eol
docs/joysheet/source-checkpoint.json -text whitespace=cr-at-eol
docs/joysheet/third-party/** -text whitespace=cr-at-eol

# R9 Deck source representation and verbatim imported provenance.
apps/joydeck*/** text=auto eol=lf
crates/joydeck-*/** text=auto eol=lf
scripts/joydeck/** text=auto eol=lf
licenses/deckcraft/** -text
licenses/joyoffice/** -text
licenses/fonts/** -text
docs/joydeck/upstream-tests/** -text
tests/fixtures/joydeck/** -text
crates/joyoffice-ui/** text=auto eol=lf
crates/joyoffice-opc/** text=auto eol=lf

# R0-R8 imported evidence is a verbatim archive with recorded byte hashes.
docs/joydeck/evidence/R[0-8]*/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
docs/joydeck/evidence/planning*.json -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
tests/fixtures/joydeck/README-pre-r9.md -text whitespace=cr-at-eol
