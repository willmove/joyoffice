# Corpus inputs are hashed byte-for-byte (tests/fixtures/manifest.json).
# Never let checkout convert their LF line endings, including on Windows.
tests/fixtures/text/** -text
# Mail merge CSV deliberately mixes CRLF records with quoted LF values.
tests/fixtures/mail-merge/*.csv -text
*.docx binary
*.dotx binary
*.docm binary
*.dotm binary
*.doc binary
*.wps binary
*.pdf binary
*.ttf binary
*.pptx binary
*.potx binary
*.ppsx binary
*.joydeck binary
*.mp4 binary
*.wav binary
*.m4a binary
*.mp3 binary
# Migrated evidence and verbatim notices carry recorded byte hashes.
docs/joydeck/evidence/** -text
docs/joyoffice/validation/** -text
licenses/joydeck/** -text
# Preserve the pinned third-party license verbatim, including original spacing.
tests/fixtures/fonts/OFL.txt -whitespace

# Product code uses one stable source representation across host platforms.
apps/joysheet*/** text=auto eol=lf
crates/joysheet-*/** text=auto eol=lf
tools/joysheet/** text=auto eol=lf
scripts/joysheet/** text=auto eol=lf
assets/joysheet/** -text

# Historical evidence and provenance retain their original bytes and hashes.
docs/joysheet/evidence/** -text whitespace=cr-at-eol
docs/joysheet/legacy-source/** -text whitespace=cr-at-eol
docs/joysheet/upstream-source.json -text whitespace=cr-at-eol
docs/joysheet/source-checkpoint.json -text whitespace=cr-at-eol
